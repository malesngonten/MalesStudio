# Server Port
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Optional for intelligent AI agent features)
GEMINI_API_KEY=

# Web Search Engine API Keys (Optional for AI web research capability)
# Tavily is the primary provider. Get free API key at https://tavily.com
TAVILY_API_KEY=

# SearXNG is an open-source metasearch engine alternative (self-hosted).
# Set to your SearXNG instance URL, e.g. https://searxng.yourdomain.com
SEARXNG_URL=
